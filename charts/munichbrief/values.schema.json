{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "application", "ingress", "admin", "persistence"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "SQLite requires exactly one application replica."
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": ["publicHosts", "canonicalOrigin", "sourceMode", "presentationMode", "secureCookies", "pageSize", "feedURL", "userAgent", "httpTimeout", "articleRefreshInterval", "gazetteerRefreshInterval", "gazetteerHTTPTimeout", "aiEnabled", "aiImmediate", "aiWindow", "ollamaBaseURL", "aiInterval", "aiTimeout", "aiContextSize"],
      "properties": {
        "contactEnabled": {"type": "boolean"},
        "contactDailyLimit": {"type": "integer", "minimum": 1, "maximum": 100000},
        "contactMonthlyLimit": {"type": "integer", "minimum": 1, "maximum": 100000},
        "contactTrustedProxies": {"type": "array", "items": {"type": "string"}},
        "publicHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}
        },
        "canonicalOrigin": {"type": "string", "pattern": "^$|^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "sourceMode": {"enum": ["fixture", "live"]},
        "presentationMode": {"enum": ["review", "public"]},
        "secureCookies": {"type": "boolean"},
        "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
        "feedURL": {"type": "string", "pattern": "^https://"},
        "userAgent": {"type": "string", "minLength": 1},
        "httpTimeout": {"type": "string", "minLength": 2},
        "articleRefreshInterval": {"type": "string", "minLength": 2},
        "gazetteerEnabled": {"type": ["boolean", "null"]},
        "gazetteerRefreshInterval": {"type": "string", "minLength": 2},
        "gazetteerHTTPTimeout": {"type": "string", "minLength": 2},
        "aiEnabled": {"type": "boolean"},
        "aiImmediate": {"type": "boolean"},
        "aiWindow": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "ollamaBaseURL": {"type": "string", "pattern": "^https?://"},
        "aiInterval": {"type": "string", "minLength": 2},
        "aiTimeout": {"type": "string", "minLength": 2},
        "aiContextSize": {"type": "integer", "minimum": 2048, "maximum": 32768},
        "existingSecret": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["lan", "public"],
      "properties": {
        "lan": {"$ref": "#/$defs/lanIngress"},
        "public": {"$ref": "#/$defs/publicIngress"}
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "required": ["enabled", "basicAuthMiddleware", "basicAuthSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "basicAuthMiddleware": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?-[a-z0-9]([-a-z0-9]*[a-z0-9])?@kubernetescrd$"
        },
        "basicAuthSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessMode", "size"],
      "properties": {
        "enabled": {"const": true},
        "storageClass": {"type": "string"},
        "accessMode": {"const": "ReadWriteOnce"},
        "size": {"type": "string", "minLength": 2},
        "annotations": {"type": "object"}
      }
    }
  },
  "$defs": {
    "lanIngress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "host", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"},
        "host": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "tls": {"type": "array"}
      },
      "additionalProperties": false
    },
    "publicIngress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "hosts", "languageCodes", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"},
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}
        },
        "languageCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$", "not": {"const": "api"}}
        },
        "tls": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}
