{
  "name": "munichbrief-frontend",
  "description": "Frontend build tooling for MunichBrief, an independent multilingual reader for Munich Police press releases.",
  "author": {
    "name": "Ege Kocabas",
    "url": "https://github.com/egekocabas"
  },
  "license": "MIT",
  "homepage": "https://munichbrief.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egekocabas/munichbrief.git"
  },
  "bugs": {
    "url": "https://github.com/egekocabas/munichbrief/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i internal/web/assets/app.css -o internal/web/static/app.css --minify",
    "build:vendor": "cp node_modules/htmx.org/dist/htmx.min.js internal/web/static/htmx.min.js && cp node_modules/htmx-ext-head-support/dist/head-support.js internal/web/static/head-support.js",
    "watch:css": "tailwindcss -i internal/web/assets/app.css -o internal/web/static/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "htmx-ext-head-support": "2.0.5",
    "htmx.org": "2.0.10",
    "tailwindcss": "4.3.3"
  }
}
